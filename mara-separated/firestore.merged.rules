rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {

  function owner() { return request.auth != null && request.auth.uid == 'QDzGG9f4fPgEBdGKm93gbnOXeC63'; }
  function validText(v,min,max) { return v is string && v.size() >= min && v.size() <= max; }
  function validGrade(g) { return g is int && g >= 1 && g <= 6; }
  function now(v) { return v == request.time; }
  function classPath(id) { return /databases/$(database)/documents/classes/$(id); }
  function learnerPath(id) { return /databases/$(database)/documents/learners/$(id); }
  function staffPath(id) { return /databases/$(database)/documents/staff/$(id); }
  function staffChangePath(id,historyId) { return /databases/$(database)/documents/staff/$(id)/changes/$(historyId); }
  function attendancePath(id) { return /databases/$(database)/documents/attendance/$(id); }
  function attendanceRevisionPath(id,historyId) { return /databases/$(database)/documents/attendance/$(id)/revisions/$(historyId); }
  function validClassReference(id,grade) { return validText(id,1,80) && exists(classPath(id)) && get(classPath(id)).data.grade == grade; }
  function validSnapshot() { let d=request.resource.data; return d.keys().hasAll(['format','version','revision','snapshot','updatedAt','updatedBy']) && d.keys().hasOnly(['format','version','revision','snapshot','updatedAt','updatedBy']) && d.format=='mara-new-admin-snapshot' && d.version==1 && d.revision is int && d.revision>=0 && d.snapshot is string && d.snapshot.size()<=716800 && d.updatedBy==request.auth.uid && now(d.updatedAt); }
  match /newAppSnapshots/wholeSchool { allow get:if owner(); allow create:if owner()&&validSnapshot()&&request.resource.data.revision==0; allow update:if owner()&&validSnapshot()&&request.resource.data.revision==resource.data.revision+1; allow list,delete:if false; }
  match /classes/{id} { allow read:if owner(); allow create:if owner()&&request.resource.data.keys().hasOnly(['name','grade','createdAt','updatedAt'])&&validText(request.resource.data.name,1,80)&&validGrade(request.resource.data.grade)&&now(request.resource.data.createdAt)&&now(request.resource.data.updatedAt); allow update:if owner()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','grade','updatedAt'])&&validText(request.resource.data.name,1,80)&&validGrade(request.resource.data.grade)&&request.resource.data.createdAt==resource.data.createdAt&&now(request.resource.data.updatedAt); allow delete:if owner(); }
  match /learners/{id} { allow read:if owner(); allow create:if owner()&&request.resource.data.keys().hasOnly(['admissionNo','firstName','lastName','grade','classId','createdAt','updatedAt'])&&validText(request.resource.data.admissionNo,1,40)&&validText(request.resource.data.firstName,1,80)&&validText(request.resource.data.lastName,1,80)&&validGrade(request.resource.data.grade)&&validClassReference(request.resource.data.classId,request.resource.data.grade)&&now(request.resource.data.createdAt)&&now(request.resource.data.updatedAt); allow update:if owner()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','grade','classId','updatedAt'])&&validText(request.resource.data.firstName,1,80)&&validText(request.resource.data.lastName,1,80)&&validGrade(request.resource.data.grade)&&validClassReference(request.resource.data.classId,request.resource.data.grade)&&request.resource.data.admissionNo==resource.data.admissionNo&&request.resource.data.createdAt==resource.data.createdAt&&now(request.resource.data.updatedAt); allow delete:if owner(); }
  function validStaff(d) { return d.keys().hasOnly(['code','name','jobTitle','active','revision','historyId','createdAt','updatedAt']) && validText(d.code,1,40)&&validText(d.name,1,100)&&validText(d.jobTitle,1,100)&&d.active is bool&&d.revision is int&&d.revision>=1&&validText(d.historyId,1,80); }
  function exactStaffHistory(d,parent,historyId,revision,action,active) { return d.keys().hasOnly(['revision','action','active','changedAt','changedBy'])&&d.revision==revision&&d.action==action&&d.active==active&&d.changedBy==request.auth.uid&&now(d.changedAt)&&getAfter(staffChangePath(parent,historyId)).data==d; }
  match /staff/{id} {
   allow read:if owner();
   allow create:if owner()&&validStaff(request.resource.data)&&request.resource.data.revision==1&&now(request.resource.data.createdAt)&&now(request.resource.data.updatedAt)&&exactStaffHistory(getAfter(staffChangePath(id,request.resource.data.historyId)).data,id,request.resource.data.historyId,1,'created',request.resource.data.active);
   allow update:if owner()&&validStaff(request.resource.data)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','revision','historyId','updatedAt'])&&request.resource.data.code==resource.data.code&&request.resource.data.name==resource.data.name&&request.resource.data.jobTitle==resource.data.jobTitle&&request.resource.data.revision==resource.data.revision+1&&request.resource.data.createdAt==resource.data.createdAt&&now(request.resource.data.updatedAt)&&exactStaffHistory(getAfter(staffChangePath(id,request.resource.data.historyId)).data,id,request.resource.data.historyId,request.resource.data.revision,request.resource.data.active?'restored':'archived',request.resource.data.active);
   allow delete:if false;
   match /changes/{historyId} { allow read:if owner(); allow create:if owner()&&validText(historyId,1,80)&&(!exists(staffPath(id)) ? exactStaffHistory(request.resource.data,id,historyId,1,'created',getAfter(staffPath(id)).data.active)&&getAfter(staffPath(id)).data.revision==1&&getAfter(staffPath(id)).data.historyId==historyId : exactStaffHistory(request.resource.data,id,historyId,get(staffPath(id)).data.revision+1,getAfter(staffPath(id)).data.active?'restored':'archived',getAfter(staffPath(id)).data.active)&&getAfter(staffPath(id)).data.revision==get(staffPath(id)).data.revision+1&&getAfter(staffPath(id)).data.historyId==historyId); allow update,delete:if false; }
  }
  function validAttendance(d,id) { return d.keys().hasOnly(['date','classId','learnerId','status','revision','historyId','createdAt','updatedAt'])&&d.date is string&&d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$')&&validText(d.classId,1,80)&&validText(d.learnerId,1,80)&&id==d.date+'_'+d.classId+'_'+d.learnerId&&d.status in ['present','absent','late','excused']&&d.revision is int&&d.revision>=1&&validText(d.historyId,1,80); }
  function exactAttendanceHistory(d,parent,historyId,revision,before,status) { return d.keys().hasOnly(['revision','beforeStatus','status','reason','changedAt','changedBy'])&&d.revision==revision&&d.beforeStatus==before&&d.status==status&&validText(d.reason,1,200)&&d.changedBy==request.auth.uid&&now(d.changedAt)&&getAfter(attendanceRevisionPath(parent,historyId)).data==d; }
  match /attendance/{id} {
   allow read:if owner();
   allow create:if owner()&&validAttendance(request.resource.data,id)&&request.resource.data.revision==1&&exists(classPath(request.resource.data.classId))&&exists(learnerPath(request.resource.data.learnerId))&&get(learnerPath(request.resource.data.learnerId)).data.classId==request.resource.data.classId&&now(request.resource.data.createdAt)&&now(request.resource.data.updatedAt)&&exactAttendanceHistory(getAfter(attendanceRevisionPath(id,request.resource.data.historyId)).data,id,request.resource.data.historyId,1,'',request.resource.data.status);
   allow update:if owner()&&validAttendance(request.resource.data,id)&&request.resource.data.date==resource.data.date&&request.resource.data.classId==resource.data.classId&&request.resource.data.learnerId==resource.data.learnerId&&request.resource.data.classId==get(learnerPath(request.resource.data.learnerId)).data.classId&&request.resource.data.revision==resource.data.revision+1&&request.resource.data.createdAt==resource.data.createdAt&&now(request.resource.data.updatedAt)&&exactAttendanceHistory(getAfter(attendanceRevisionPath(id,request.resource.data.historyId)).data,id,request.resource.data.historyId,request.resource.data.revision,resource.data.status,request.resource.data.status);
   allow delete:if false;
   match /revisions/{historyId} { allow read:if owner(); allow create:if owner()&&validText(historyId,1,80)&&(!exists(attendancePath(id)) ? exactAttendanceHistory(request.resource.data,id,historyId,1,'',getAfter(attendancePath(id)).data.status)&&getAfter(attendancePath(id)).data.revision==1&&getAfter(attendancePath(id)).data.historyId==historyId : exactAttendanceHistory(request.resource.data,id,historyId,get(attendancePath(id)).data.revision+1,get(attendancePath(id)).data.status,getAfter(attendancePath(id)).data.status)&&getAfter(attendancePath(id)).data.revision==get(attendancePath(id)).data.revision+1&&getAfter(attendancePath(id)).data.historyId==historyId); allow update,delete:if false; }
  }
  match /{document=**} { allow read,write:if false; }
 
 match /testWorkspaces/modules-v1 {

  function owner() { return request.auth != null && request.auth.uid == 'QDzGG9f4fPgEBdGKm93gbnOXeC63'; }
  function validText(v,min,max) { return v is string && v.size() >= min && v.size() <= max; }
  function validGrade(g) { return g is int && g >= 1 && g <= 6; }
  function now(v) { return v == request.time; }
  function classPath(id) { return /databases/$(database)/documents/testWorkspaces/modules-v1/classes/$(id); }
  function learnerPath(id) { return /databases/$(database)/documents/testWorkspaces/modules-v1/learners/$(id); }
  function staffPath(id) { return /databases/$(database)/documents/testWorkspaces/modules-v1/staff/$(id); }
  function staffChangePath(id,historyId) { return /databases/$(database)/documents/testWorkspaces/modules-v1/staff/$(id)/changes/$(historyId); }
  function attendancePath(id) { return /databases/$(database)/documents/testWorkspaces/modules-v1/attendance/$(id); }
  function attendanceRevisionPath(id,historyId) { return /databases/$(database)/documents/testWorkspaces/modules-v1/attendance/$(id)/revisions/$(historyId); }
  function validClassReference(id,grade) { return validText(id,1,80) && exists(classPath(id)) && get(classPath(id)).data.grade == grade; }
  function validSnapshot() { let d=request.resource.data; return d.keys().hasAll(['format','version','revision','snapshot','updatedAt','updatedBy']) && d.keys().hasOnly(['format','version','revision','snapshot','updatedAt','updatedBy']) && d.format=='mara-new-admin-snapshot' && d.version==1 && d.revision is int && d.revision>=0 && d.snapshot is string && d.snapshot.size()<=716800 && d.updatedBy==request.auth.uid && now(d.updatedAt); }
  match /newAppSnapshots/wholeSchool { allow get:if owner(); allow create:if owner()&&validSnapshot()&&request.resource.data.revision==0; allow update:if owner()&&validSnapshot()&&request.resource.data.revision==resource.data.revision+1; allow list,delete:if false; }
  match /classes/{id} { allow read:if owner(); allow create:if owner()&&request.resource.data.keys().hasOnly(['name','grade','createdAt','updatedAt'])&&validText(request.resource.data.name,1,80)&&validGrade(request.resource.data.grade)&&now(request.resource.data.createdAt)&&now(request.resource.data.updatedAt); allow update:if owner()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','grade','updatedAt'])&&validText(request.resource.data.name,1,80)&&validGrade(request.resource.data.grade)&&request.resource.data.createdAt==resource.data.createdAt&&now(request.resource.data.updatedAt); allow delete:if false; }
  match /learners/{id} { allow read:if owner(); allow create:if owner()&&request.resource.data.keys().hasOnly(['admissionNo','firstName','lastName','grade','classId','createdAt','updatedAt'])&&validText(request.resource.data.admissionNo,1,40)&&validText(request.resource.data.firstName,1,80)&&validText(request.resource.data.lastName,1,80)&&validGrade(request.resource.data.grade)&&validClassReference(request.resource.data.classId,request.resource.data.grade)&&now(request.resource.data.createdAt)&&now(request.resource.data.updatedAt); allow update:if owner()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','grade','classId','updatedAt'])&&validText(request.resource.data.firstName,1,80)&&validText(request.resource.data.lastName,1,80)&&validGrade(request.resource.data.grade)&&validClassReference(request.resource.data.classId,request.resource.data.grade)&&request.resource.data.admissionNo==resource.data.admissionNo&&request.resource.data.createdAt==resource.data.createdAt&&now(request.resource.data.updatedAt); allow delete:if false; }
  function validStaff(d) { return d.keys().hasOnly(['code','name','jobTitle','active','revision','historyId','createdAt','updatedAt']) && validText(d.code,1,40)&&validText(d.name,1,100)&&validText(d.jobTitle,1,100)&&d.active is bool&&d.revision is int&&d.revision>=1&&validText(d.historyId,1,80); }
  function exactStaffHistory(d,parent,historyId,revision,action,active) { return d.keys().hasOnly(['revision','action','active','changedAt','changedBy'])&&d.revision==revision&&d.action==action&&d.active==active&&d.changedBy==request.auth.uid&&now(d.changedAt)&&getAfter(staffChangePath(parent,historyId)).data==d; }
  match /staff/{id} {
   allow read:if owner();
   allow create:if owner()&&validStaff(request.resource.data)&&request.resource.data.revision==1&&now(request.resource.data.createdAt)&&now(request.resource.data.updatedAt)&&exactStaffHistory(getAfter(staffChangePath(id,request.resource.data.historyId)).data,id,request.resource.data.historyId,1,'created',request.resource.data.active);
   allow update:if owner()&&validStaff(request.resource.data)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','revision','historyId','updatedAt'])&&request.resource.data.code==resource.data.code&&request.resource.data.name==resource.data.name&&request.resource.data.jobTitle==resource.data.jobTitle&&request.resource.data.revision==resource.data.revision+1&&request.resource.data.createdAt==resource.data.createdAt&&now(request.resource.data.updatedAt)&&exactStaffHistory(getAfter(staffChangePath(id,request.resource.data.historyId)).data,id,request.resource.data.historyId,request.resource.data.revision,request.resource.data.active?'restored':'archived',request.resource.data.active);
   allow delete:if false;
   match /changes/{historyId} { allow read:if owner(); allow create:if owner()&&validText(historyId,1,80)&&(!exists(staffPath(id)) ? exactStaffHistory(request.resource.data,id,historyId,1,'created',getAfter(staffPath(id)).data.active)&&getAfter(staffPath(id)).data.revision==1&&getAfter(staffPath(id)).data.historyId==historyId : exactStaffHistory(request.resource.data,id,historyId,get(staffPath(id)).data.revision+1,getAfter(staffPath(id)).data.active?'restored':'archived',getAfter(staffPath(id)).data.active)&&getAfter(staffPath(id)).data.revision==get(staffPath(id)).data.revision+1&&getAfter(staffPath(id)).data.historyId==historyId); allow update,delete:if false; }
  }
  function validAttendance(d,id) { return d.keys().hasOnly(['date','classId','learnerId','status','revision','historyId','createdAt','updatedAt'])&&validDate(d.date)&&validText(d.classId,1,80)&&validText(d.learnerId,1,80)&&id==d.date+'_'+d.classId+'_'+d.learnerId&&d.status in ['present','absent','late','excused']&&d.revision is int&&d.revision>=1&&validText(d.historyId,1,80); }
  function exactAttendanceHistory(d,parent,historyId,revision,before,status) { return d.keys().hasOnly(['revision','beforeStatus','status','reason','changedAt','changedBy'])&&d.revision==revision&&d.beforeStatus==before&&d.status==status&&validText(d.reason,1,200)&&d.changedBy==request.auth.uid&&now(d.changedAt)&&getAfter(attendanceRevisionPath(parent,historyId)).data==d; }
  match /attendance/{id} {
   allow read:if owner();
   allow create:if owner()&&validAttendance(request.resource.data,id)&&request.resource.data.revision==1&&exists(classPath(request.resource.data.classId))&&exists(learnerPath(request.resource.data.learnerId))&&get(learnerPath(request.resource.data.learnerId)).data.classId==request.resource.data.classId&&now(request.resource.data.createdAt)&&now(request.resource.data.updatedAt)&&exactAttendanceHistory(getAfter(attendanceRevisionPath(id,request.resource.data.historyId)).data,id,request.resource.data.historyId,1,'',request.resource.data.status);
   allow update:if owner()&&validAttendance(request.resource.data,id)&&request.resource.data.date==resource.data.date&&request.resource.data.classId==resource.data.classId&&request.resource.data.learnerId==resource.data.learnerId&&request.resource.data.classId==get(learnerPath(request.resource.data.learnerId)).data.classId&&request.resource.data.revision==resource.data.revision+1&&request.resource.data.createdAt==resource.data.createdAt&&now(request.resource.data.updatedAt)&&exactAttendanceHistory(getAfter(attendanceRevisionPath(id,request.resource.data.historyId)).data,id,request.resource.data.historyId,request.resource.data.revision,resource.data.status,request.resource.data.status);
   allow delete:if false;
   match /revisions/{historyId} { allow read:if owner(); allow create:if owner()&&validText(historyId,1,80)&&(!exists(attendancePath(id)) ? exactAttendanceHistory(request.resource.data,id,historyId,1,'',getAfter(attendancePath(id)).data.status)&&getAfter(attendancePath(id)).data.revision==1&&getAfter(attendancePath(id)).data.historyId==historyId : exactAttendanceHistory(request.resource.data,id,historyId,get(attendancePath(id)).data.revision+1,get(attendancePath(id)).data.status,getAfter(attendancePath(id)).data.status)&&getAfter(attendancePath(id)).data.revision==get(attendancePath(id)).data.revision+1&&getAfter(attendancePath(id)).data.historyId==historyId); allow update,delete:if false; }
  }
  match /{document=**} { allow read,write:if false; }
 

  // Isolated expanded candidate. No candidate path can access the public baseline.
  function candidateClassPath(id){return /databases/$(database)/documents/testWorkspaces/modules-v1/classes/$(id);}
  function candidateLearnerPath(id){return /databases/$(database)/documents/testWorkspaces/modules-v1/learners/$(id);}
  function candidateStaffPath(id){return /databases/$(database)/documents/testWorkspaces/modules-v1/staff/$(id);}
  // Owner-only fictional candidate. Every cross-document invariant is atomic.
  function rec(id){return /databases/$(database)/documents/testWorkspaces/modules-v1/candidateRecords/$(id);}
  function audit(id,n){return /databases/$(database)/documents/testWorkspaces/modules-v1/candidateRecords/$(id)/audit/$(n);}
  function idx(c,id){return /databases/$(database)/documents/testWorkspaces/modules-v1/$(c)/$(id);}
  // Strict Gregorian ISO date, bounded 2020–2100. Firestore Rules has no safe date parser.
  function validDate(s){return s is string&&s.matches('^((202[0-9]|20[3-9][0-9]|2100)-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|(202[048]|20[2468][048]|20[13579][26])-02-29)$');}
  function vt(v,a,b){return v is string&&v.size()>=a&&v.size()<=b;}
  function own(){return request.auth!=null&&request.auth.uid=='QDzGG9f4fPgEBdGKm93gbnOXeC63';}
  function aud(d,a,n){return d.keys().hasOnly(['action','revision','reason','actor','at'])&&d.action==a&&d.revision==n&&vt(d.reason,1,300)&&d.actor==request.auth.uid&&d.at==request.time;}
  function initial(d,k){return d.kind==k&&d.revision==1&&d.auditId=='a1'&&d.createdAt==request.time&&d.updatedAt==request.time;}
  function source(id){return get(rec(id)).data;}
  function audit1(id){return aud(getAfter(audit(id,'a1')).data,'created',1);}
  function term(d){return d.keys().hasOnly(['kind','label','startDate','endDate','revision','auditId','createdAt','updatedAt'])&&initial(d,'term')&&vt(d.label,1,100)&&validDate(d.startDate)&&validDate(d.endDate)&&d.startDate<=d.endDate;}
  function subject(d){return d.keys().hasOnly(['kind','label','classId','revision','auditId','createdAt','updatedAt'])&&initial(d,'subject')&&vt(d.label,1,100)&&exists(candidateClassPath(d.classId));}
  function mark(d,id){return d.keys().hasOnly(['kind','learnerId','subjectId','termId','score','status','revision','auditId','createdAt','updatedAt'])&&initial(d,'mark')&&d.status=='draft'&&d.score is int&&d.score>=0&&d.score<=100&&exists(candidateLearnerPath(d.learnerId))&&exists(rec(d.subjectId))&&exists(rec(d.termId))&&source(d.subjectId).kind=='subject'&&source(d.termId).kind=='term'&&get(candidateLearnerPath(d.learnerId)).data.classId==source(d.subjectId).classId&&getAfter(idx('markAssessmentIndex',d.learnerId+'_'+d.subjectId+'_'+d.termId)).data.markId==id&&getAfter(idx('markRevisionState',id)).data.revision==1&&getAfter(idx('markRevisionState',id)).data.score==d.score&&getAfter(idx('markRevisionState',id)).data.status=='draft'&&getAfter(idx('markRevisionState',id)).data.latestCorrectionId=='';}
  function markCorrection(d,id){let prior=get(idx('markRevisionState',d.markId)).data;let after=getAfter(idx('markRevisionState',d.markId)).data;return d.keys().hasOnly(['kind','markId','beforeScore','score','reason','approvedBy','revision','auditId','createdAt','updatedAt'])&&d.kind=='markCorrection'&&d.auditId=='a1'&&d.createdAt==request.time&&d.updatedAt==request.time&&vt(d.markId,1,120)&&exists(rec(d.markId))&&source(d.markId).kind=='mark'&&source(d.markId).status=='published'&&d.beforeScore==prior.score&&d.score is int&&d.score>=0&&d.score<=100&&d.score!=d.beforeScore&&vt(d.reason,3,300)&&d.approvedBy==request.auth.uid&&d.revision==prior.revision+1&&after.revision==d.revision&&after.score==d.score&&after.status=='published'&&after.latestCorrectionId==id;}
  function ledger(d){return d.keys().hasOnly(['kind','learnerId','entryType','amountCents','transactionRef','reversalOf','reason','approvedBy','revision','auditId','createdAt','updatedAt'])&&initial(d,'ledger')&&exists(candidateLearnerPath(d.learnerId))&&d.amountCents is int&&d.amountCents>0&&d.amountCents<=100000000&&vt(d.reason,1,300)&&d.approvedBy==request.auth.uid;}
  function charge(d){return ledger(d)&&d.entryType=='charge'&&d.transactionRef==''&&d.reversalOf=='';}
  function payment(d,id){return ledger(d)&&d.entryType=='payment'&&vt(d.transactionRef,4,120)&&d.reversalOf==''&&getAfter(idx('paymentReferenceIndex',d.transactionRef)).data.entryId==id;}
  function reversal(d,id){return ledger(d)&&d.entryType=='reversal'&&d.transactionRef==''&&exists(rec(d.reversalOf))&&source(d.reversalOf).kind=='ledger'&&source(d.reversalOf).entryType in ['charge','payment']&&source(d.reversalOf).learnerId==d.learnerId&&source(d.reversalOf).amountCents==d.amountCents&&getAfter(idx('reversalIndex',d.reversalOf)).data.entryId==id;}
  function house(d){return d.keys().hasOnly(['kind','label','capacity','revision','auditId','createdAt','updatedAt'])&&initial(d,'house')&&vt(d.label,1,100)&&d.capacity is int&&d.capacity>0&&d.capacity<=1000;}
  function allocation(d,id){return d.keys().hasOnly(['kind','learnerId','houseId','bedSlot','revision','auditId','createdAt','updatedAt'])&&initial(d,'allocation')&&exists(candidateLearnerPath(d.learnerId))&&exists(rec(d.houseId))&&source(d.houseId).kind=='house'&&d.bedSlot is int&&d.bedSlot>=1&&d.bedSlot<=source(d.houseId).capacity&&getAfter(idx('houseBedIndex',d.houseId+'_'+string(d.bedSlot))).data.allocationId==id&&getAfter(idx('learnerAllocationIndex',d.learnerId)).data.allocationId==id;}
  function approval(d){return d.keys().hasOnly(['kind','learnerId','reason','leaveDate','status','revision','auditId','createdAt','updatedAt'])&&initial(d,'leaveApproval')&&exists(candidateLearnerPath(d.learnerId))&&vt(d.reason,3,300)&&validDate(d.leaveDate)&&d.status=='approved'&&exists(idx('learnerAllocationIndex',d.learnerId));}
  function roll(d,id){return d.keys().hasOnly(['kind','allocationId','date','present','revision','auditId','createdAt','updatedAt'])&&initial(d,'rollCall')&&exists(rec(d.allocationId))&&source(d.allocationId).kind=='allocation'&&validDate(d.date)&&d.present is bool&&getAfter(idx('rollCallIndex',d.allocationId+'_'+d.date)).data.recordId==id;}
