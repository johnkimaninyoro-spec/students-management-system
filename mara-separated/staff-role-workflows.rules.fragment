// STAFF ROLE WORKFLOWS — replacement fragment. Insert inside match /testWorkspaces/modules-v1 before final catch-all.
function swProfilePath(uid){return /databases/$(database)/documents/testWorkspaces/modules-v1/accessProfiles/$(uid);}
function swEnabled(){return request.auth!=null&&exists(swProfilePath(request.auth.uid))&&get(swProfilePath(request.auth.uid)).data.enabled==true;}
function swRole(){return get(swProfilePath(request.auth.uid)).data.role;}
function swOwner(){return request.auth!=null&&request.auth.uid=='QDzGG9f4fPgEBdGKm93gbnOXeC63';}
function swAdmin(){return swEnabled()&&swRole()=='admin';}
function swId(v){return v is string&&v.size()>=1&&v.size()<=80;}
function swText(v,min,max){return v is string&&v.size()>=min&&v.size()<=max;}
function swScore(v){return v is int&&v>=0&&v<=100;}
function swMarkPath(id){return /databases/$(database)/documents/testWorkspaces/modules-v1/staffWorkflowMarks/$(id);}
function swCorrectionPath(id){return /databases/$(database)/documents/testWorkspaces/modules-v1/staffMarkCorrections/$(id);}
function swLearnerPath(id){return /databases/$(database)/documents/testWorkspaces/modules-v1/learners/$(id);}
function swRecordPath(id){return /databases/$(database)/documents/testWorkspaces/modules-v1/candidateRecords/$(id);}
function swTeachingScope(learnerId,subjectId){return exists(swLearnerPath(learnerId))&&exists(swRecordPath(subjectId))&&get(swLearnerPath(learnerId)).data.classId in get(swProfilePath(request.auth.uid)).data.classIds&&subjectId in get(swProfilePath(request.auth.uid)).data.subjectIds&&get(swRecordPath(subjectId)).data.kind=='subject'&&get(swRecordPath(subjectId)).data.classId==get(swLearnerPath(learnerId)).data.classId;}
function swTeacher(){return swEnabled()&&swRole() in ['teacher','classTeacher'];}
function swReviewer(){return swEnabled()&&swRole() in ['headteacher','admin'];}
function swAuthor(d){return request.auth!=null&&d.authorUid==request.auth.uid;}
function swMarkReadable(d){return swOwner()||swAdmin()||(swTeacher()&&swAuthor(d)&&swTeachingScope(d.learnerId,d.subjectId));}
function swMarkShape(d){return d.keys().hasOnly(['learnerId','subjectId','termId','score','supersedesMarkId','correctionId','authorUid','status','revision','authoredAt','submittedAt','reviewedAt','reviewedBy','returnedReason','publishedAt'])&&swId(d.learnerId)&&swId(d.subjectId)&&swId(d.termId)&&swScore(d.score)&&(d.supersedesMarkId==''||swId(d.supersedesMarkId))&&(d.correctionId==''||swId(d.correctionId))&&swId(d.authorUid)&&d.status in ['draft','submitted','returned','approved','published']&&d.revision is int&&d.revision>=1&&d.authoredAt is timestamp&&(d.submittedAt==null||d.submittedAt is timestamp)&&(d.reviewedAt==null||d.reviewedAt is timestamp)&&(d.publishedAt==null||d.publishedAt is timestamp)&&d.reviewedBy is string&&d.returnedReason is string&&d.returnedReason.size()<=300;}
function swNewMark(d){return swMarkShape(d)&&(swTeacher()||swAdmin()||swOwner())&&d.authorUid==request.auth.uid&&d.status=='draft'&&d.revision==1&&d.authoredAt==request.time&&d.submittedAt==null&&d.reviewedAt==null&&d.reviewedBy==''&&d.returnedReason==''&&d.publishedAt==null&&d.correctionId==''&&((swTeacher()&&swTeachingScope(d.learnerId,d.subjectId))||swAdmin()||swOwner());}
function swNewCorrectionVersion(d){let c=get(swCorrectionPath(d.correctionId)).data;let o=get(swMarkPath(d.supersedesMarkId)).data;return (swReviewer()||swOwner())&&d.correctionId!=''&&d.supersedesMarkId!=''&&exists(swCorrectionPath(d.correctionId))&&c.status=='requested'&&c.replacementMarkId==''&&c.markId==d.supersedesMarkId&&c.requestedScore==d.score&&o.status=='published'&&d.learnerId==o.learnerId&&d.subjectId==o.subjectId&&d.termId==o.termId&&d.authorUid==o.authorUid&&d.status=='published'&&d.revision==1&&d.authoredAt==request.time&&d.submittedAt==request.time&&d.reviewedAt==request.time&&d.reviewedBy==request.auth.uid&&d.returnedReason==''&&d.publishedAt==request.time;}
function swEventPath(markId,eventId){return /databases/$(database)/documents/testWorkspaces/modules-v1/staffWorkflowMarks/$(markId)/events/$(eventId);}
function swMarkEventAfter(markId,revision,action,note){return existsAfter(swEventPath(markId,'e'+string(revision)))&&getAfter(swEventPath(markId,'e'+string(revision))).data.action==action&&getAfter(swEventPath(markId,'e'+string(revision))).data.actorUid==request.auth.uid&&getAfter(swEventPath(markId,'e'+string(revision))).data.at==request.time&&getAfter(swEventPath(markId,'e'+string(revision))).data.note==note;}
function swMarkEdit(d){return swAuthor(resource.data)&&resource.data.status in ['draft','returned']&&d.diff(resource.data).affectedKeys().hasOnly(['score','revision','returnedReason'])&&swScore(d.score)&&d.revision==resource.data.revision+1&&d.returnedReason=='';}
function swMarkSubmission(d){return swAuthor(resource.data)&&((swTeacher()&&swTeachingScope(resource.data.learnerId,resource.data.subjectId))||swAdmin()||swOwner())&&d.diff(resource.data).affectedKeys().hasOnly(['status','revision','submittedAt'])&&resource.data.status in ['draft','returned']&&d.status=='submitted'&&d.revision==resource.data.revision+1&&d.submittedAt==request.time&&swMarkEventAfter(request.resource.id,d.revision,'submitted','');}
function swMarkReview(d){return (swReviewer()||swOwner())&&d.diff(resource.data).affectedKeys().hasOnly(['status','revision','reviewedAt','reviewedBy','returnedReason'])&&resource.data.status=='submitted'&&d.status in ['approved','returned']&&d.revision==resource.data.revision+1&&d.reviewedAt==request.time&&d.reviewedBy==request.auth.uid&&((d.status=='approved'&&d.returnedReason==''&&swMarkEventAfter(request.resource.id,d.revision,'approved',''))||(d.status=='returned'&&swText(d.returnedReason,3,300)&&swMarkEventAfter(request.resource.id,d.revision,'returned',d.returnedReason)));}
function swMarkPublish(d){return (swReviewer()||swOwner())&&d.diff(resource.data).affectedKeys().hasOnly(['status','revision','publishedAt'])&&resource.data.status=='approved'&&d.status=='published'&&d.revision==resource.data.revision+1&&d.publishedAt==request.time&&swMarkEventAfter(request.resource.id,d.revision,'published','');}
function swMarkEvent(d,markId,eventId){return d.keys().hasOnly(['action','actorUid','at','note'])&&d.action in ['submitted','approved','returned','published']&&d.actorUid==request.auth.uid&&d.at==request.time&&d.note is string&&d.note.size()<=300&&eventId.matches('^e[1-9][0-9]*$');}
match /staffWorkflowMarks/{markId}{allow get,list:if swMarkReadable(resource.data);allow create:if swNewMark(request.resource.data)||swNewCorrectionVersion(request.resource.data);allow update:if swMarkShape(request.resource.data)&&(swMarkEdit(request.resource.data)||swMarkSubmission(request.resource.data)||swMarkReview(request.resource.data)||swMarkPublish(request.resource.data));allow delete:if false;}
match /staffWorkflowMarks/{markId}/events/{eventId}{allow get,list:if exists(swMarkPath(markId))&&swMarkReadable(get(swMarkPath(markId)).data);allow create:if eventId.matches('^e[1-9][0-9]*$')&&((swTeacher()&&request.resource.data.action=='submitted')||((swReviewer()||swOwner())&&request.resource.data.action in ['approved','returned','published']))&&swMarkEvent(request.resource.data,markId,eventId);allow update,delete:if false;}
function swCorrectionShape(d){return d.keys().hasOnly(['markId','requestedBy','requestedScore','reason','status','revision','requestedAt','reviewedAt','reviewedBy','returnedReason','replacementMarkId'])&&swId(d.markId)&&swId(d.requestedBy)&&swScore(d.requestedScore)&&swText(d.reason,3,300)&&d.status in ['requested','approved','returned']&&d.revision is int&&d.revision>=1&&d.requestedAt is timestamp&&(d.reviewedAt==null||d.reviewedAt is timestamp)&&d.reviewedBy is string&&d.returnedReason is string&&d.returnedReason.size()<=300&&(d.replacementMarkId==''||swId(d.replacementMarkId));}
function swNewCorrection(d){return swCorrectionShape(d)&&(swTeacher()||swAdmin()||swOwner())&&d.requestedBy==request.auth.uid&&d.status=='requested'&&d.revision==1&&d.requestedAt==request.time&&d.reviewedAt==null&&d.reviewedBy==''&&d.returnedReason==''&&d.replacementMarkId==''&&exists(swMarkPath(d.markId))&&get(swMarkPath(d.markId)).data.status=='published'&&((swTeacher()&&get(swMarkPath(d.markId)).data.authorUid==request.auth.uid&&swTeachingScope(get(swMarkPath(d.markId)).data.learnerId,get(swMarkPath(d.markId)).data.subjectId))||swAdmin()||swOwner());}
function swCorrectionEventPath(correctionId,eventId){return /databases/$(database)/documents/testWorkspaces/modules-v1/staffMarkCorrections/$(correctionId)/events/$(eventId);}
function swCorrectionEventAfter(correctionId,revision,action,note){return existsAfter(swCorrectionEventPath(correctionId,'e'+string(revision)))&&getAfter(swCorrectionEventPath(correctionId,'e'+string(revision))).data.action==action&&getAfter(swCorrectionEventPath(correctionId,'e'+string(revision))).data.actorUid==request.auth.uid&&getAfter(swCorrectionEventPath(correctionId,'e'+string(revision))).data.at==request.time&&getAfter(swCorrectionEventPath(correctionId,'e'+string(revision))).data.note==note;}
function swCorrectionReview(d){return (swReviewer()||swOwner())&&d.diff(resource.data).affectedKeys().hasOnly(['status','revision','reviewedAt','reviewedBy','returnedReason','replacementMarkId'])&&resource.data.status=='requested'&&d.status in ['approved','returned']&&d.revision==resource.data.revision+1&&d.reviewedAt==request.time&&d.reviewedBy==request.auth.uid&&((d.status=='returned'&&swText(d.returnedReason,3,300)&&d.replacementMarkId==''&&swCorrectionEventAfter(request.resource.id,d.revision,'returned',d.returnedReason))||(d.status=='approved'&&d.returnedReason==''&&swId(d.replacementMarkId)&&existsAfter(swMarkPath(d.replacementMarkId))&&getAfter(swMarkPath(d.replacementMarkId)).data.correctionId==request.resource.id&&getAfter(swMarkPath(d.replacementMarkId)).data.supersedesMarkId==resource.data.markId&&getAfter(swMarkPath(d.replacementMarkId)).data.score==resource.data.requestedScore&&swCorrectionEventAfter(request.resource.id,d.revision,'approved','')));}
function swCorrectionReadable(d){return swOwner()||swAdmin()||(swTeacher()&&d.requestedBy==request.auth.uid&&exists(swMarkPath(d.markId))&&swTeachingScope(get(swMarkPath(d.markId)).data.learnerId,get(swMarkPath(d.markId)).data.subjectId));}
function swCorrectionEvent(d,correctionId,eventId){return d.keys().hasOnly(['action','actorUid','at','note'])&&d.action in ['approved','returned']&&d.actorUid==request.auth.uid&&d.at==request.time&&d.note is string&&d.note.size()<=300&&eventId.matches('^e[2-9][0-9]*$');}
match /staffMarkCorrections/{correctionId}{allow get,list:if swCorrectionReadable(resource.data);allow create:if swNewCorrection(request.resource.data);allow update:if swCorrectionShape(request.resource.data)&&swCorrectionReview(request.resource.data);allow delete:if false;}
match /staffMarkCorrections/{correctionId}/events/{eventId}{allow get,list:if exists(swCorrectionPath(correctionId))&&swCorrectionReadable(get(swCorrectionPath(correctionId)).data);allow create:if eventId.matches('^e[2-9][0-9]*$')&&(swReviewer()||swOwner())&&swCorrectionEvent(request.resource.data,correctionId,eventId);allow update,delete:if false;}
// Intake is review metadata only: it does not write a ledger/payment and must not be presented as payment completion.
function swPaymentShape(d){return d.keys().hasOnly(['learnerId','amountCents','transactionRef','evidenceKind','evidenceSha256','evidenceMimeType','requestedBy','status','revision','requestedAt','reviewedAt','reviewedBy','reviewReason'])&&swId(d.learnerId)&&d.amountCents is int&&d.amountCents>0&&d.amountCents<=100000000&&d.transactionRef is string&&d.transactionRef.matches('^[A-Z0-9_]{8,120}$')&&d.evidenceKind in ['mpesa','kcbDepositSlip','cheque']&&d.evidenceSha256 is string&&d.evidenceMimeType is string&&swId(d.requestedBy)&&d.status in ['submitted','approved','rejected']&&d.revision is int&&d.revision>=1&&d.requestedAt is timestamp&&(d.reviewedAt==null||d.reviewedAt is timestamp)&&d.reviewedBy is string&&d.reviewReason is string&&d.reviewReason.size()<=300;}
function swFinance(){return swEnabled()&&swRole()=='finance';}
function swEvidenceOk(d){return (d.evidenceKind=='mpesa'&&d.evidenceSha256==''&&d.evidenceMimeType=='')||(d.evidenceKind in ['kcbDepositSlip','cheque']&&d.evidenceSha256.matches('^[a-f0-9]{64}$')&&d.evidenceMimeType in ['image/jpeg','image/png','application/pdf']);}
function swNewPayment(d){return swPaymentShape(d)&&swFinance()&&d.requestedBy==request.auth.uid&&d.status=='submitted'&&d.revision==1&&d.requestedAt==request.time&&d.reviewedAt==null&&d.reviewedBy==''&&d.reviewReason==''&&exists(swLearnerPath(d.learnerId))&&swEvidenceOk(d);}
function swPaymentReview(d){return (swAdmin()||swOwner())&&d.diff(resource.data).affectedKeys().hasOnly(['status','revision','reviewedAt','reviewedBy','reviewReason'])&&resource.data.status=='submitted'&&d.status in ['approved','rejected']&&d.revision==resource.data.revision+1&&d.reviewedAt==request.time&&d.reviewedBy==request.auth.uid&&((d.status=='approved'&&d.reviewReason=='')||(d.status=='rejected'&&swText(d.reviewReason,3,300)));}
match /staffFinancePaymentIntakes/{intakeId}{allow get,list:if swOwner()||swAdmin()||(swFinance()&&resource.data.requestedBy==request.auth.uid);allow create:if swNewPayment(request.resource.data);allow update:if swPaymentShape(request.resource.data)&&swPaymentReview(request.resource.data);allow delete:if false;match /events/{eventId}{allow read,write:if false;}}
