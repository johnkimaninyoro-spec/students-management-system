rules_version = '2';
// Staging only: mara-school-test
service cloud.firestore {
 match /databases/{database}/documents {
  function testAdmin() { return request.auth != null && request.auth.uid == '7f1a8Q2xrYfGZm6FkD4TWs2X3462'; }
  function validSnapshot() {
   let d = request.resource.data;
   return d.keys().hasAll(['format','version','revision','snapshot','updatedAt','updatedBy'])
    && d.keys().hasOnly(['format','version','revision','snapshot','updatedAt','updatedBy'])
    && d.format == 'mara-new-admin-snapshot' && d.version == 1
    && d.revision is int && d.revision >= 0 && d.snapshot is string && d.snapshot.size() <= 716800
    && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
  }
  match /newAppSnapshots/wholeSchool {
   allow get: if testAdmin();
   allow create: if testAdmin() && validSnapshot() && request.resource.data.revision == 0;
   allow update: if testAdmin() && validSnapshot() && request.resource.data.revision == resource.data.revision + 1;
   allow list, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
